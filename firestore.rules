rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 員工 = 登入且 uid 在 staff 名單內。staff 只能由後端 / Console 寫入。
    // 不能只檢查 request.auth != null：匿名或自行註冊的帳號也會通過。
    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function hasOnlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function stringField(field) {
      return field in request.resource.data &&
        request.resource.data[field] is string;
    }

    function numberField(field) {
      return field in request.resource.data &&
        request.resource.data[field] is number;
    }

    function intField(field) {
      return field in request.resource.data &&
        request.resource.data[field] is int;
    }

    function optionalString(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is string;
    }

    function optionalNumber(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is number;
    }

    function optionalBool(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is bool;
    }

    function optionalMap(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is map;
    }

    function optionalList(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is list;
    }

    function optionalTimestampOrInt(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        request.resource.data[field] is timestamp ||
        request.resource.data[field] is int;
    }

    function fieldUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function noSensitiveOrderAggregates() {
      return !request.resource.data.keys().hasAny([
        'itemSummary',
        'fabricSummary',
        'materialCost',
        'outsourcingCost',
        'totalCost',
        'totalProfit',
        'isFabricOrdered'
      ]);
    }

    function clientWritableOrderFields() {
      return [
        'uniqueId',
        'customerId',
        'customerName',
        'subtotal',
        'discount',
        'total',
        'deposit',
        'balancePayment',
        'balancePaymentMethod',
        'balancePaidDate',
        'balance',
        'payments',
        'laborCost',
        'fixedCost',
        'status',
        'paymentMethod',
        'createdAt',
        'updatedAt',
        'date',
        'deliveryDate',
        'notes'
      ];
    }

    function validOrderClientUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(clientWritableOrderFields());
    }

    function validOrder() {
      return hasOnlyFields([
          'uniqueId',
          'customerId',
          'customerName',
          'itemSummary',
          'fabricSummary',
          'subtotal',
          'discount',
          'total',
          'deposit',
          'balancePayment',
          'balancePaymentMethod',
          'balancePaidDate',
          'balance',
          'payments',
          'materialCost',
          'laborCost',
          'outsourcingCost',
          'fixedCost',
          'totalCost',
          'totalProfit',
          'status',
          'paymentMethod',
          'createdAt',
          'updatedAt',
          'date',
          'deliveryDate',
          'isFabricOrdered',
          'notes'
        ]) &&
        hasRequiredFields([
          'uniqueId',
          'customerId',
          'customerName',
          'subtotal',
          'discount',
          'total',
          'deposit',
          'balance',
          'status',
          'paymentMethod'
        ]) &&
        stringField('uniqueId') &&
        stringField('customerId') &&
        stringField('customerName') &&
        numberField('subtotal') &&
        numberField('discount') &&
        numberField('total') &&
        numberField('deposit') &&
        numberField('balance') &&
        stringField('status') &&
        stringField('paymentMethod') &&
        optionalString('itemSummary') &&
        optionalString('fabricSummary') &&
        optionalNumber('balancePayment') &&
        optionalString('balancePaymentMethod') &&
        optionalTimestampOrInt('balancePaidDate') &&
        optionalNumber('materialCost') &&
        optionalNumber('laborCost') &&
        optionalNumber('outsourcingCost') &&
        optionalNumber('fixedCost') &&
        optionalNumber('totalCost') &&
        optionalNumber('totalProfit') &&
        optionalTimestampOrInt('createdAt') &&
        optionalTimestampOrInt('updatedAt') &&
        optionalTimestampOrInt('date') &&
        optionalTimestampOrInt('deliveryDate') &&
        optionalBool('isFabricOrdered') &&
        optionalList('payments') &&
        optionalString('notes');
    }

    function validOrderItem() {
      return hasOnlyFields([
          'id',
          'orderId',
          'service',
          'price',
          'quantity',
          'fabricId',
          'fabricName',
          'fabricUsed',
          'cost',
          'isFabricOrdered',
          'manualUnitPrice',
          'serviceName',
          'fabricCode',
          'fabricCost',
          'fabricUsage',
          'updatedAt'
        ]) &&
        hasRequiredFields(['id', 'orderId', 'service', 'price', 'quantity']) &&
        stringField('id') &&
        stringField('orderId') &&
        stringField('service') &&
        numberField('price') &&
        intField('quantity') &&
        optionalString('fabricId') &&
        optionalString('fabricName') &&
        optionalNumber('fabricUsed') &&
        optionalNumber('cost') &&
        optionalBool('isFabricOrdered') &&
        optionalBool('manualUnitPrice') &&
        optionalString('serviceName') &&
        optionalString('fabricCode') &&
        optionalNumber('fabricCost') &&
        optionalNumber('fabricUsage') &&
        optionalTimestampOrInt('updatedAt');
    }

    function validInventoryItem() {
      return hasOnlyFields([
          'name',
          'costPerUnit',
          'unit',
          'stock',
          'reorderLevel',
          'imageUrl',
          'category',
          'retailPrice',
          'isOnline',
          'color'
        ]) &&
        hasRequiredFields(['name', 'costPerUnit', 'unit', 'stock', 'reorderLevel']) &&
        stringField('name') &&
        numberField('costPerUnit') &&
        stringField('unit') &&
        numberField('stock') &&
        numberField('reorderLevel') &&
        optionalString('imageUrl') &&
        optionalString('category') &&
        optionalNumber('retailPrice') &&
        optionalBool('isOnline') &&
        optionalString('color');
    }

    function validWorkshopOrder() {
      return hasOnlyFields([
          'orderId',
          'customer',
          'item',
          'status',
          'priority',
          'dueDate',
          'progress',
          'notes',
          'isFabricOrdered',
          'createdAt',
          'updatedAt'
        ]) &&
        hasRequiredFields([
          'orderId',
          'customer',
          'item',
          'status',
          'priority',
          'dueDate',
          'progress'
        ]) &&
        stringField('orderId') &&
        stringField('customer') &&
        stringField('item') &&
        stringField('status') &&
        stringField('priority') &&
        intField('dueDate') &&
        intField('progress') &&
        optionalString('notes') &&
        optionalBool('isFabricOrdered') &&
        optionalTimestampOrInt('createdAt') &&
        optionalTimestampOrInt('updatedAt');
    }

    function validCustomer() {
      return hasOnlyFields([
          'name',
          'email',
          'phone',
          'orders',
          'totalSpent',
          'createdAt',
          'measurements',
          'nextFollowUp'
        ]) &&
        hasRequiredFields(['name', 'email', 'phone', 'orders', 'totalSpent']) &&
        stringField('name') &&
        stringField('email') &&
        stringField('phone') &&
        intField('orders') &&
        numberField('totalSpent') &&
        optionalTimestampOrInt('createdAt') &&
        optionalMap('measurements') &&
        optionalTimestampOrInt('nextFollowUp');
    }

    function validService() {
      return hasOnlyFields([
          'id',
          'name',
          'price',
          'defaultFabricUsage',
          'durationDays',
          'markupMultiplier',
          'allowModifiers',
          'outsourcingCost'
        ]) &&
        hasRequiredFields(['name', 'price', 'defaultFabricUsage', 'durationDays']) &&
        stringField('name') &&
        numberField('price') &&
        numberField('defaultFabricUsage') &&
        intField('durationDays') &&
        optionalString('id') &&
        optionalNumber('markupMultiplier') &&
        optionalBool('allowModifiers') &&
        optionalNumber('outsourcingCost');
    }

    function validOrderImage() {
      return hasOnlyFields(['orderId', 'imageUrl', 'fileName', 'uploadedAt']) &&
        hasRequiredFields(['orderId', 'imageUrl', 'fileName']) &&
        stringField('orderId') &&
        stringField('imageUrl') &&
        stringField('fileName') &&
        optionalTimestampOrInt('uploadedAt');
    }

    function validContactLog() {
      return hasOnlyFields(['type', 'notes', 'createdAt', 'followUpDate']) &&
        hasRequiredFields(['type', 'notes', 'createdAt']) &&
        stringField('type') &&
        stringField('notes') &&
        request.resource.data.type in ['call', 'fitting', 'message', 'note'] &&
        optionalTimestampOrInt('followUpDate');
    }

    function validSetting(settingId) {
      return settingId == 'measurements' &&
          hasOnlyFields(['fields']) &&
          optionalList('fields');
    }

    match /orders/{orderId} {
      allow read: if isStaff();
      allow create: if isStaff() && validOrder() && noSensitiveOrderAggregates();
      allow update: if isStaff() && validOrderClientUpdate();
      allow delete: if isStaff();
    }

    match /order_items/{itemId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && validOrderItem();
      allow delete: if isStaff();
    }

    match /inventory/{itemId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && validInventoryItem();
      allow delete: if isStaff();
    }

    match /workshop_orders/{workshopOrderId} {
      allow read: if isStaff();
      allow create: if isStaff() &&
        validWorkshopOrder() &&
        (!(request.resource.data.isFabricOrdered == true));
      allow update: if isStaff() &&
        validWorkshopOrder() &&
        fieldUnchanged('isFabricOrdered');
      allow delete: if isStaff();
    }

    match /customers/{customerId} {
      allow read: if isStaff();
      allow create: if isStaff() &&
        validCustomer() &&
        request.resource.data.orders == 0 &&
        request.resource.data.totalSpent == 0;
      allow update: if isStaff() &&
        validCustomer() &&
        fieldUnchanged('orders') &&
        fieldUnchanged('totalSpent');
      allow delete: if isStaff();

      match /contact_logs/{logId} {
        allow read: if isStaff();
        allow create: if isStaff() && validContactLog();
        allow delete: if isStaff();
      }
    }

    match /services/{serviceId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && validService();
      allow delete: if isStaff();
    }

    match /order_images/{imageId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && validOrderImage();
      allow delete: if isStaff();
    }

    // 訂製訂單：Alexis Bespoke App 可以建立、讀取，同編輯／刪除未匯入嘅訂單；
    // 已匯入 POS 嘅訂單內容唔可再修改或刪除，避免同 POS 那邊失去對應。
    match /bespoke_orders/{orderId} {
      allow read: if isStaff();
      allow create: if isStaff() &&
        !request.resource.data.keys().hasAny(['posOrderId', 'posOrderNo', 'importedAt']);
      // 兩種情況先准更新，兩種都要求訂單本身仲未匯入（posOrderId 為空）：
      //   1. POS 匯入：只准寫 posOrderId / posOrderNo / importedAt 呢三個欄位。
      //   2. 職員編輯訂單內容：唔可以掂呢三個 POS 專用欄位（保持未匯入狀態）。
      allow update: if isStaff() &&
        resource.data.get('posOrderId', '') == '' &&
        (
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['posOrderId', 'posOrderNo', 'importedAt']) &&
           request.resource.data.posOrderId is string &&
           request.resource.data.posOrderId != '') ||
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['posOrderId', 'posOrderNo', 'importedAt'])
        );
      // 只容許員工刪除「未匯入 POS」嘅訂單（例如建錯單）；已匯入嘅唔可以刪，避免 POS 訂單失去對應。
      allow delete: if isStaff() &&
        resource.data.get('posOrderId', '') == '';
    }

    match /settings/{settingId} {
      allow read: if isStaff() && settingId in ['order_counter', 'measurements'];
      allow create, update: if isStaff() && validSetting(settingId);
      allow delete: if false;
    }

    // 員工名單：使用者只能讀取自己的那筆（用來判斷是否有權限），任何 client 都不可寫入。
    match /staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
