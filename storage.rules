rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 員工 = 登入且 uid 在 Firestore staff 名單內（見 firestore.rules）。
    function isStaff() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid));
    }

    function validImageUpload() {
      return request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    function validImageFileName(fileName) {
      return fileName.matches('.*[.](jpg|jpeg|png|webp|JPG|JPEG|PNG|WEBP)$');
    }

    match /order_images/{orderId}/{fileName} {
      allow read: if isStaff();
      allow create, update: if isStaff() &&
        validImageUpload() &&
        validImageFileName(fileName);
      allow delete: if isStaff();
    }

    match /fabric_images/{fileName} {
      allow read: if isStaff();
      allow create, update: if isStaff() &&
        validImageUpload() &&
        validImageFileName(fileName);
      allow delete: if isStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
